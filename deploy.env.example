# Copy to deploy.env (git-ignored) and fill in. deploy.sh reads it.
# Values may be 1Password secret references (op://vault/item/field); deploy.sh then runs through `op run`.

# Cloudflare account that hosts the Worker (dashboard URL: dash.cloudflare.com/<this id>).
CLOUDFLARE_ACCOUNT_ID=
# API token from the "Edit Cloudflare Workers" template, with Zone access to the zone of BRIDGE_DOMAIN.
CLOUDFLARE_API_TOKEN=
# Hostname to serve the bridge on. Must be in a zone on that account; Cloudflare creates the DNS record.
BRIDGE_DOMAIN=links.example.com
